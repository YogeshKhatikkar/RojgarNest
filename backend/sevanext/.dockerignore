# ============================================================
# SevaNext Backend — Docker ignore
# ============================================================
# Files/folders NOT sent to Docker build context.
# Prevents secret leaks + speeds up builds 10×.
# ============================================================

# ---- Secrets ----
.env
.env.*
!.env.example

# ---- Git ----
.git/
.gitignore
.gitattributes

# ---- Python cache ----
__pycache__/
*.py[cod]
*.so
.Python
*$py.class

# ---- Virtualenv ----
.venv/
venv/
env/
ENV/
.python-version

# ---- Test / coverage ----
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
coverage.xml
.tox/
.nox/

# ---- IDE / OS ----
.idea/
.vscode/
*.iml
*.swp
*.swo
.DS_Store
Thumbs.db

# ---- Runtime data (bind-mounted at runtime) ----
logs/
uploads/
secure/
models/
backups/
*.log

# ---- Node (Flutter web build leftovers) ----
node_modules/

# ---- Docs ----
README.md
CHANGELOG.md
LICENSE
docs/

# ---- Docker / CI ----
Dockerfile
.dockerignore
docker-compose*.yml
.github/

# ---- Large model files ----
*.h5
*.pkl
*.joblib
*.pt
*.onnx
*.bin

# ---- Misc ----
*.sqlite3
*.db
*.sql
*.tar.gz
*.zip