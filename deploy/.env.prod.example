# ============================================================
# PROD — COMPOSE ENV (EXAMPLE)
# ============================================================
# Server par:
#   cp .env.prod.example .env.prod
#   nano .env.prod
#   chmod 600 .env.prod
#
# ⚠️ .env.prod NEVER commit to git. Sirf ye .example file commit hoti hai.
# ============================================================

COMPOSE_PROJECT_NAME=rojgarnest-prod

# ⚠️ CRITICAL — MongoDB root user
# Only use alphanumeric (A-Z, a-z, 0-9). Min 32 chars.
# Generate:  openssl rand -hex 24
MONGO_ROOT_USERNAME=rojgar_admin
MONGO_ROOT_PASSWORD=CHANGE_ME_STRONG_32_CHAR_PASSWORD

# Domain (used by nginx)
DOMAIN=www.rojgarnest.com